# ========================================
# Backend Environment Variables
# ========================================
# Copy this file to .env and configure for your deployment.
# All values shown are defaults used when not explicitly set.

# ========================================
# Server Configuration
# ========================================

# Port number for the Express server to listen on.
# Railway and similar platforms automatically inject this value.
# Default: 3000
PORT=3000

# Application environment mode.
# Values: development | production
# Affects logging verbosity, error details in responses, and optimization.
# Default: development
NODE_ENV=production

# Human-readable server location displayed in API responses (/api/info).
# Examples: "Railway EU-West (Amsterdam, Netherlands)", "AWS us-east-1"
# This helps users understand which server they're testing against.
# Default: EU WEST (Amsterdam, Netherlands)
SERVER_LOCATION=Railway EU-West (Amsterdam, Netherlands)

# ========================================
# CORS & Security
# ========================================

# Allowed origins for Cross-Origin Resource Sharing.
# Use "*" to allow all origins (recommended for public speed test APIs).
# For restricted access, use comma-separated domains: "https://app.com,https://staging.app.com"
# Default: *
CORS_ORIGIN=*

# ========================================
# Transfer Limits
# ========================================

# Maximum file size in megabytes for download speed tests.
# Larger values allow testing higher-speed connections but consume more bandwidth.
# The /api/download endpoint clamps user requests to this limit.
# Range: 1-1000 MB
# Default: 50
MAX_DOWNLOAD_SIZE_MB=50

# Maximum file size in megabytes for upload speed tests.
# This is an advisory limit; actual enforcement depends on body parser configuration.
# Range: 1-1000 MB
# Default: 50
MAX_UPLOAD_SIZE_MB=50

# ========================================
# Rate Limiting
# ========================================

# Enable rate limiting to prevent API abuse.
# Applied to lightweight endpoints (/api/ping, /api/info, /api/ping-batch).
# Download and upload endpoints are excluded to allow accurate speed testing.
# Set to false for internal benchmarking or trusted environments.
# Default: true
ENABLE_RATE_LIMIT=true

# Time window in milliseconds for rate limit counting.
# 60000 = 1 minute window.
# Default: 60000
RATE_LIMIT_WINDOW_MS=60000

# Maximum number of requests allowed per IP within the time window.
# Recommended: 60-240 depending on expected legitimate usage patterns.
# Default: 120
RATE_LIMIT_MAX=120

# ========================================
# Circuit Breaker
# ========================================

# Maximum concurrent requests before rejecting new connections with 503 Service Unavailable.
# Protects server from overload by limiting simultaneous transfers.
# Note: In horizontally scaled deployments (multiple instances), this limit applies per instance.
# Example: 3 instances × 100 limit = 300 total concurrent requests.
# Adjust based on server memory and bandwidth capacity.
# Range: 1+ (recommended: 50-200)
# Default: 100
MAX_INFLIGHT_REQUESTS=100

# ========================================
# Observability
# ========================================

# Enable Prometheus metrics endpoint at /metrics.
# Exposes HTTP request counts, durations, data transfer volumes, and system metrics.
# Recommended for production monitoring and alerting.
# Default: true
ENABLE_METRICS=true

# Logging verbosity level for application and HTTP request logs.
# Values: debug | info | warn | error
# - debug: Verbose logging for development and troubleshooting
# - info: Standard operational logs (recommended for production)
# - warn: Only warnings and errors
# - error: Only errors
# Default: info
LOG_LEVEL=info

# ========================================
# Deployment Notes
# ========================================
# - Railway/Render/Heroku: These platforms auto-inject PORT; no need to set it manually.
# - Multi-region: Set SERVER_LOCATION per instance to identify test server location.
# - High-traffic: Increase MAX_INFLIGHT_REQUESTS and monitor memory usage.
# - Private API: Replace CORS_ORIGIN=* with specific allowed domains.
# - Benchmarking: Disable ENABLE_RATE_LIMIT to remove artificial latency.
# - Monitoring: Enable ENABLE_METRICS and configure Prometheus scraping.